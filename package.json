{
  "name": "bg2hhw-personal-site",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler pages dev . --persist-to .wrangler/state --binding ADMIN_PASSWORD=dev-admin --binding SESSION_SECRET=dev-session-secret-change-me",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler pages deploy . --project-name bg2hhw-site"
  },
  "devDependencies": {
    "wrangler": "^4.135.0"
  }
}
